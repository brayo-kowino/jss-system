rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Single source of truth for the caller's own user doc. Firestore
    // caches get()/exists() calls to the same path for the life of one
    // rule evaluation, so calling this several times below is still just
    // one document read, not one per call.
    function myProfile() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data
        : null;
    }

    // Gate check: has THIS token's account cleared device-approval and (if
    // enabled) 2FA, per the custom claims set server-side by
    // device-register.ts / login-approval-redeem.ts / two-factor-verify.ts.
    // Those claims are the only thing standing between "valid ID token" and
    // "ordinary data access" for a session that never went through the
    // approval/2FA UI at all - e.g. a stolen token used directly against
    // the Firestore SDK/REST API, skipping router.js's auth-gate entirely.
    //
    // Both claims are expiry timestamps (ISO strings), not bare booleans -
    // see claimExpiryIso() in lib/firestore-rest.ts for why. A claim past
    // its expiry is treated exactly like a claim that was never granted -
    // and so is a claim that was NEVER SET AT ALL (e.g. an admin/super_admin
    // token that has never once gone through device-register.ts, or a 2FA-
    // enabled account's token that's never gone through two-factor-verify.ts
    // this session). Each existence/type/expiry check below is written as a
    // single `&&` so it both short-circuits safely (no runtime error from
    // calling timestamp.value() on an absent field) AND correctly requires
    // the claim - a standalone `!('claim' in token) || ...` bypass term
    // would make an unverified token pass this check outright, which is
    // the exact case this gate exists to block.
    //
    // IMPORTANT SCOPE CAVEAT (documented here on purpose, not silently
    // assumed): Firebase custom claims are account-wide, not per-device or
    // per-session. Once deviceApprovedUntil is set for this uid, it's on
    // every token for this uid until it expires - including one held by
    // someone who phished the password and never went through
    // device-register.ts themselves. The expiry bounds that exposure to a
    // finite window instead of forever; it doesn't eliminate it. Fully
    // eliminating it needs claims bound to one specific sign-in event via a
    // Firebase Auth Blocking Function, which is new infrastructure beyond
    // what's deployed here.
    function isFullyVerified() {
      return isSignedIn()
        && (myProfile() == null
            || (myProfile().get('role', '') != 'admin' && myProfile().get('role', '') != 'super_admin')
            || ('deviceApprovedUntil' in request.auth.token
                && request.auth.token.deviceApprovedUntil is string
                && request.time < timestamp.value(request.auth.token.deviceApprovedUntil)))
        && (myProfile() == null
            || myProfile().get('twoFactorEnabled', false) != true
            || ('twoFactorVerifiedUntil' in request.auth.token
                && request.auth.token.twoFactorVerifiedUntil is string
                && request.time < timestamp.value(request.auth.token.twoFactorVerifiedUntil)));
    }

    function isUserActive() {
      return isSignedIn() && myProfile() != null
        && (!('status' in myProfile()) || myProfile().status != 'suspended');
    }

    function myRole() {
      return isUserActive() && ('role' in myProfile()) ? myProfile().role : null;
    }

    // null for super_admin (platform-level, not tied to one school),
    // for anyone whose profile doesn't exist yet, or for suspended accounts.
    function mySchoolId() {
      return isUserActive() && ('schoolId' in myProfile()) ? myProfile().schoolId : null;
    }

    function isAdmin() {
      return myRole() == 'admin';
    }

    function isPrincipal() {
      return myRole() == 'principal';
    }

    function isSuperAdmin() {
      return myRole() == 'super_admin';
    }

    function isStaff() {
      return myRole() in [
        'admin', 'principal', 'deputy_principal', 'academic_master',
        'class_teacher', 'subject_teacher', 'bursar', 'registrar'
      ];
    }

    // Least-privilege groups, mirrored 1:1 from what the app itself lets
    // each role actually do (nav.js route gates + each view's in-page
    // CAN_MANAGE/CAN_SAVE/CAN_MARK_ANY_CLASS/CAN_EDIT_* constants). Kept
    // here as named groups rather than inlined per match block so the
    // mapping from "who can touch this collection" to "who can touch it
    // in the UI" stays easy to audit and keep in sync.
    function inRoles(roles) {
      return myRole() in roles;
    }

    // Students, their guardians, and front-desk issue tickets are all
    // edited from the same Students page - roles: admin, principal,
    // deputy_principal, registrar, class_teacher.
    function canManageStudents() {
      return inRoles(['admin', 'principal', 'deputy_principal', 'registrar', 'class_teacher']);
    }

    // Teacher Module (accounts/subject+class assignments) - Teachers page:
    // admin, principal only.
    function canManageTeachers() {
      return inRoles(['admin', 'principal']);
    }

    // Term structure (grades/streams, subjects, timetable periods+slots) -
    // admin, academic_master only.
    function canManageAcademicStructure() {
      return inRoles(['admin', 'academic_master']);
    }

    // Creating/editing/locking assessments - admin, academic_master only
    // (subject_teacher can *see* the Assessments page to check status/max
    // score before entering marks, but the page's own canManage gate keeps
    // add/edit/delete/lock to admin+academic_master).
    function canManageAssessments() {
      return inRoles(['admin', 'academic_master']);
    }

    // Entering marks - the actual teachers doing the marking, plus the
    // roles that can enter on anyone's behalf.
    function canEnterMarks() {
      return inRoles(['admin', 'academic_master', 'subject_teacher', 'class_teacher']);
    }

    // Computing/publishing class results - admin, academic_master only.
    function canComputeResults() {
      return inRoles(['admin', 'academic_master']);
    }

    // Marking attendance - class_teacher for their own class, admin/
    // principal for any class.
    function canMarkAttendance() {
      return inRoles(['admin', 'principal', 'class_teacher']);
    }

    // Fee structures + payments - admin, bursar only.
    function canManageFees() {
      return inRoles(['admin', 'bursar']);
    }

    // Notifications + Newsletters - everyone reads them, this narrower set
    // can compose/send/delete.
    function canManageComms() {
      return inRoles(['admin', 'principal', 'deputy_principal', 'academic_master', 'class_teacher', 'bursar', 'registrar']);
    }

    // A role alone doesn't prove *which* school's data someone may touch -
    // every doc in the operational collections carries a schoolId field
    // written by the app, and these two checks are what actually enforce
    // the tenant boundary between schools. isSubscriptionActive() is
    // folded in here too (see definition above) - single choke point, so
    // every operational collection below is automatically hard-locked the
    // instant a school's subscription lapses, with no per-collection edits
    // needed. This deliberately does NOT touch isStaff() itself, because
    // the schools/{schoolId} read rule uses isStaff() directly (not
    // ownsExisting/ownsIncoming) and must keep working even when expired -
    // the app needs to read the school doc's own subscription fields to
    // know it's expired and show the lock screen in the first place.
    // isFullyVerified() (2FA/device-approval) and isSubscriptionActive()
    // (subscription lock) are both folded in here - this is the single
    // choke point every operational collection below depends on, so both
    // checks apply automatically with no per-collection changes needed.
    // NOTE: isSubscriptionActive() and isFullyVerified() are defined below/
    // above this point respectively - Firestore Rules functions aren't
    // order-dependent within the same service block, so forward references
    // are fine.
    function ownsExisting() {
      return isUserActive() && isFullyVerified() && isSubscriptionActive()
        && (resource == null || (mySchoolId() != null && resource.data.schoolId == mySchoolId()));
    }
    function ownsIncoming() {
      return isFullyVerified() && isSubscriptionActive()
        && mySchoolId() != null && request.resource.data.schoolId == mySchoolId();
    }
    function ownsBoth() {
      return isFullyVerified() && isSubscriptionActive()
        && resource != null && mySchoolId() != null && resource.data.schoolId == mySchoolId() && request.resource.data.schoolId == mySchoolId();
    }

    // True once an assessment has been locked - checked against the
    // *incoming* mark write's own assessmentId, so this is enforced at the
    // database layer and can't be bypassed by a direct SDK/API call that
    // skips marks.service.js's own client-side lock check.
    function assessmentIsLocked(assessmentId) {
      return assessmentId != null
        && exists(/databases/$(database)/documents/assessments/$(assessmentId))
        && ('status' in get(/databases/$(database)/documents/assessments/$(assessmentId)).data)
        && get(/databases/$(database)/documents/assessments/$(assessmentId)).data.status == 'locked';
    }

    // ------------------------------------------------------------------
    // Subscription enforcement.
    // This USED to be a live get() on schools/{schoolId} (see git history),
    // same shape as myProfile()'s single-doc cache. That caching is scoped
    // to ONE document's rule evaluation, not the whole request - it is
    // NOT shared across the several documents touched by a single batched
    // write/transaction. ownsIncoming()/ownsBoth() run on every operational
    // write, so any write path that batches multiple documents (marking
    // attendance for a whole class roster in one batch;
    // fee.service.js's syncStudentFeeStatus()/resyncFeeStatusForGrade()
    // updating every affected student alongside a payment) paid that get()
    // once per document instead of once per request - cost scaling
    // linearly with roster/grade size until it tipped over Firestore's
    // rules-evaluation budget and came back as a bare PERMISSION_DENIED,
    // indistinguishable from an actual rules denial. isSubscriptionActive()
    // was folded into ownsExisting() too (see the comment above it), so
    // reads paid this same per-document cost - it just didn't show up as
    // visibly because the app's read patterns happen to batch fewer
    // documents at once than the attendance-roster/fee-resync writes do.
    //
    // isSubscriptionActive() now reads a subscriptionActiveUntil custom
    // claim instead of doing a get() at all, so it's free to call from
    // ownsIncoming()/ownsBoth() no matter how large the batch is. The
    // claim is minted as an ISO expiry - not a bare boolean - so it keeps
    // the same "self-expires the instant the term is up" property the old
    // live check had, rather than staying valid forever once granted.
    //
    // Trade-off this introduces: a claim is only as fresh as the caller's
    // ID token, and (unlike the per-user deviceApprovedUntil/
    // twoFactorVerifiedUntil claims) subscription status applies to an
    // entire school's staff at once, not just the one user who triggered
    // the change. Every place that can flip it - subscription-activate.ts,
    // subscription-revoke.ts, and school-status.ts (Suspend/Reactivate) -
    // now fans the claim out to every user of that school via
    // syncSubscriptionClaims() in lib/firestore-rest.ts, using the same
    // privileged service-account credential that writes the schools/{id}
    // fields themselves. An already-open tab only picks up the change on
    // its next ID token refresh (Firebase does this automatically roughly
    // hourly). That's an acceptable gap because subscription-gate.ts's
    // app-shell check already hard-blocks a suspended/lapsed school before
    // any Firestore call happens on a fresh navigation - this rule was
    // always the backstop for an already-open tab, not the front door, so
    // a short staleness window here doesn't reopen the thing it exists to
    // close.
    //
    // super_admin has no schoolId and manages the Schools registry itself
    // (not gated by any single school's subscription), so it's exempt -
    // same as before.
    //
    // NOTE: `status` ("active" | "suspended", the Platform Admin's Suspend/
    // Reactivate button) used to be writable directly by a super_admin's
    // client SDK call. It no longer is - see touchesSubscriptionFields()
    // below - because a direct client write would change schools/{id}
    // without ever calling syncSubscriptionClaims(), silently reopening
    // the exact "suspended school's staff can keep writing" gap this claim
    // exists to close. Suspend/Reactivate now goes through
    // school-status.ts instead, same shape as activate/revoke.
    function isSubscriptionActive() {
      return mySchoolId() == null || (
        'subscriptionActiveUntil' in request.auth.token
        && request.auth.token.subscriptionActiveUntil is string
        && request.time < timestamp.value(request.auth.token.subscriptionActiveUntil)
      );
    }

    // Fields nobody can touch directly through a normal document write on
    // schools/{schoolId} - only the subscription edge functions
    // (subscription-activate.ts/subscription-revoke.ts) and school-status.ts
    // (running with a privileged service-account credential that bypasses
    // rules entirely) can set these. `status` is included here - not just
    // the subscriptionX fields - because every one of these functions also
    // calls syncSubscriptionClaims() to fan the subscriptionActiveUntil
    // claim out to the school's staff; a direct client write (even from
    // super_admin, who is otherwise exempt from this carve-out below in
    // the schools/{schoolId} match block) would change the doc without
    // ever re-minting that claim, leaving isSubscriptionActive() looking
    // at a stale claim until tokens happen to refresh on their own.
    function touchesSubscriptionFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'subscriptionStatus', 'subscriptionPlan', 'subscriptionExpiresAt',
        'subscriptionActivatedAt', 'subscriptionActivatedBy', 'subscriptionTokenId',
        'status'
      ]);
    }

    // Users can always read their own profile. Admins/super_admin manage
    // accounts, but only within their own school - an admin at School A
    // can no longer read or edit School B's users by guessing a uid.
    // Principals may additionally create a teacher login (the one thing
    // the Teacher Module lets a principal do), but nothing else - they
    // can't hand out admin/registrar/etc. accounts this way.
    //
    // isFullyVerified() gates every branch below where the ACTOR is
    // exercising admin/super_admin privilege over someone else's account
    // (reading another profile, creating/editing/deleting a login) - this
    // is exactly the class of action the device-approval/2FA framework
    // exists to protect, so a stolen admin token that never cleared that
    // gate can't use it to mint or hijack accounts. It deliberately does
    // NOT gate self-read or the narrow self-update below: those have to
    // keep working before deviceApprovedUntil/twoFactorVerifiedUntil
    // claims exist at all, since the app reads its own profile (to decide
    // whether the gate even applies) and clears mustChangePassword during
    // onboarding, before any device/2FA step has happened yet.
    match /users/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (isFullyVerified() && (
          isSuperAdmin() ||
          ((isAdmin() || isPrincipal()) && (resource == null || resource.data.schoolId == mySchoolId()))
        ))
      );
      allow create: if isFullyVerified() && (
        isSuperAdmin()
        || (isAdmin() && request.resource.data.schoolId == mySchoolId() && request.resource.data.role != 'super_admin')
        || (isPrincipal() && request.resource.data.schoolId == mySchoolId()
            && request.resource.data.role in ['class_teacher', 'subject_teacher'])
      );
      allow update: if (isFullyVerified() && (
            isSuperAdmin()
            || (isAdmin() && resource.data.schoolId == mySchoolId()
                && resource.data.role != 'super_admin'
                && request.resource.data.role != 'super_admin'
                && request.resource.data.schoolId == mySchoolId())
          ))
        || (isUserActive() && request.auth.uid == uid
            // twoFactorEnabled/twoFactorSecret/twoFactorBackupCodes/
            // twoFactorEnabledAt used to be in this list. A client write
            // to those fields was gated on nothing but "is this your own
            // uid" - no code check, no server verification - so a
            // compromised session could flip twoFactorEnabled on/off (or
            // swap the secret) with zero proof of possessing an
            // authenticator. Those fields are now only ever written by
            // netlify/edge-functions/two-factor-enable.ts and
            // two-factor-disable.ts, using the service-account credential
            // that bypasses these rules entirely - same pattern as
            // touchesSubscriptionFields() below for schools/{id}.
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword', 'updatedAt']));
      allow delete: if isFullyVerified()
        && (isSuperAdmin() || (isAdmin() && resource.data.schoolId == mySchoolId() && resource.data.role != 'super_admin'));
    }

    // Trusted devices for admin account protection. Each admin's browser
    // registers itself here after the first forced password change;
    // subsequent logins from unrecognized devices trigger an approval
    // workflow. Users can manage their own devices; an admin or super_admin
    // can reset another user's devices (e.g. if they lose access to their
    // primary device and can't approve a new login) - that's a privileged
    // account-recovery action (resetting someone's devices drops them back
    // to isGenuineBootstrap, so their very next login auto-trusts whatever
    // device they use with no approval step), so it's gated by
    // isFullyVerified() same as the admin-acting branches in users/{uid}
    // above. Self-access is never gated by it - needed for the device's
    // own lastSeenAt bump below regardless of claim state.
    match /users/{uid}/trusted_devices/{deviceId} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        (isFullyVerified() && (
          isSuperAdmin() ||
          (isAdmin() && exists(/databases/$(database)/documents/users/$(uid)) &&
           get(/databases/$(database)/documents/users/$(uid)).data.schoolId == mySchoolId())
        ))
      );
      // create used to be "if isSignedIn() && request.auth.uid == uid" -
      // meaning any session for this account, however it was obtained,
      // could mark itself as trusted with no proof of a recent password
      // entry or an approved login. Trusted-device creation now only ever
      // comes from netlify/edge-functions/device-register.ts (requires a
      // fresh auth_time, i.e. a real password entry, or genuine
      // first-device bootstrap) and login-approval-redeem.ts (requires an
      // already-approved request) - both via the service-account
      // credential, which bypasses these rules entirely. No client create
      // is allowed here anymore.
      allow create: if false;
      // Narrow carve-out: the device's own session may still bump its own
      // lastSeenAt timestamp (device.service.js's updateLastSeen()) - that's
      // a cosmetic "last seen" display value, not a trust grant, so it's
      // safe to leave self-writable. Nothing else on the doc (isPrimary,
      // fingerprint, etc.) can be touched this way.
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeenAt']);
      allow delete: if isSignedIn() && (
        request.auth.uid == uid ||
        (isFullyVerified() && (
          isSuperAdmin() ||
          (isAdmin() && exists(/databases/$(database)/documents/users/$(uid)) &&
           get(/databases/$(database)/documents/users/$(uid)).data.schoolId == mySchoolId())
        ))
      );
    }

    // Login approval requests for admin accounts. Created when an admin
    // logs in from an unrecognized device; the primary device watches for
    // pending approvals via onSnapshot and can approve or deny them.
    //
    // Creating a fresh 'pending' request is still a plain client write -
    // that's just "someone is trying to log in," not itself a grant of
    // anything. What used to be the actual bypass is that the SAME
    // session could also perform `allow update` and flip its own request's
    // status straight to 'approved' - no separate approving device, no 2FA,
    // nothing. Deciding a request (status -> approved/denied) and
    // redeeming an approved one into a trusted device now only ever happen
    // in netlify/edge-functions/login-approval-approve.ts and
    // login-approval-redeem.ts, via the service-account credential that
    // bypasses these rules entirely - so `allow update` is false here,
    // full stop.
    match /users/{uid}/login_approvals/{approvalId} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolvedAt == null
        && request.resource.data.resolvedBy == null;
      allow update: if false;
      allow delete: if isSignedIn() && (
        request.auth.uid == uid || isSuperAdmin()
      );
    }

    // School registry + per-school settings/branding doc (schools/{id} -
    // the doc's own ID *is* its schoolId, so it's compared directly
    // rather than via a schoolId field). Staff read/write only their own
    // school's doc; the platform super_admin manages every school's
    // registry entry (create, suspend/reactivate, list).
    match /schools/{schoolId} {
      allow read: if isSignedIn() && (isSuperAdmin() || schoolId == mySchoolId());
      // Only the super_admin (via createSchool) ever creates a school doc.
      allow create: if isSuperAdmin();
      // An admin can update their own school's profile/branding/settings
      // as always, but never the subscription fields (or, now, `status` -
      // see touchesSubscriptionFields() above) - those only ever change via
      // the edge functions' privileged service-account write, which
      // bypasses this rule entirely (so this "deny" only ever blocks a
      // client SDK call, which is exactly the point). super_admin used to
      // be exempt from this carve-out (it could still write `status`
      // directly, since Suspend/Reactivate was a plain client write) - now
      // that Suspend/Reactivate goes through school-status.ts instead, that
      // exemption would only ever let a super_admin's browser silently
      // desync `status` from the subscriptionActiveUntil claim, so it's
      // gone: every actor, super_admin included, goes through
      // touchesSubscriptionFields() here.
      allow update: if (isSuperAdmin() || (isAdmin() && schoolId == mySchoolId()))
        && !touchesSubscriptionFields();
      allow delete: if isSuperAdmin();
    }

    // Every signed token this platform has ever issued (see
    // subscription-issue.ts). Purely a server-side ledger - the "consumed"
    // check that makes a token single-use lives here, read/written only by
    // the edge functions' service-account credential. No client, including
    // super_admin's own browser session, ever reads or writes this
    // collection directly, hence the flat deny below (documented rather
    // than left to silent default-deny, same reasoning as lookup_attempts).
    match /subscription_tokens/{tokenId} {
      allow read, write: if false;
    }

    // Narrow, deliberately public mirror of a school's cosmetic branding
    // only (name/logo/colors/status), keyed by the school's human-friendly
    // login code rather than its Firestore doc ID. This is what lets the
    // sign-in screen show the right school's look *before* anyone has
    // authenticated - readable by anyone, but only ever holds fields an
    // anonymous visitor is already meant to see on a login page. Writes
    // stay restricted to that school's own admin (or the super_admin), and
    // are only ever made from settings.service.js/school.service.js.
    match /school_public/{slug} {
      allow read: if true;
      allow create: if isSuperAdmin() || (isAdmin() && request.resource.data.schoolId == mySchoolId());
      allow update: if isSuperAdmin() || (isAdmin() && resource.data.schoolId == mySchoolId() && request.resource.data.schoolId == mySchoolId());
      allow delete: if isSuperAdmin() || (isAdmin() && resource.data.schoolId == mySchoolId());
    }

    // ------------------------------------------------------------------
    // Everything below replaces one old blanket "any staff role can
    // read/write any operational collection in their own school" rule.
    // That let a subject_teacher (or bursar, or registrar...) create,
    // edit or delete records completely outside their job - e.g. edit
    // fee structures, delete other teachers, rewrite student records,
    // publish results, or wipe timetable slots - as long as the school
    // ID matched, because Firestore rules were never actually checking
    // *what* a signed-in staff member was allowed to touch, only which
    // school. Each collection below now has its own read/write rule that
    // mirrors what the app's own UI already treats as that role's job.
    // ------------------------------------------------------------------

    // Students - read: any staff (needed across attendance, marks,
    // reports, fees...). Write: only the roles the Students page exposes
    // edit controls to.
    match /students/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageStudents() && ownsIncoming();
      allow update: if canManageStudents() && ownsBoth();
      allow delete: if false; // app never deletes students, only archives/transfers via update
    }

    // Parents - same write group as students, since registering/editing a
    // student also links/unlinks the child on the parent doc
    // (linkStudentToParent/unlinkStudentFromParent) as part of that same
    // save. Read stays staff-wide (report cards, contact lookups, etc).
    match /parents/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageStudents() && ownsIncoming();
      allow update: if canManageStudents() && ownsBoth();
      allow delete: if canManageStudents() && ownsExisting();
    }

    // Front-desk issue tickets against a student record - raised/resolved
    // only from the Students page, so same group as students.
    match /student_issues/{docId} {
      allow read: if canManageStudents() && ownsExisting();
      allow create: if canManageStudents() && ownsIncoming();
      allow update: if canManageStudents() && ownsBoth();
      allow delete: if false;
    }

    // Teacher accounts/assignments - PII (phone, TSC number, email) that
    // no longer needs to be world-readable to every staff role. Read is
    // admin/principal (Teachers page), academic_master (Analytics), or the
    // teacher's own linked record (marks/attendance entry resolves "which
    // subjects/classes am I assigned" via getTeacherByUserId). Write stays
    // admin/principal only, matching the Teachers page.
    match /teachers/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageTeachers() && ownsIncoming();
      allow update: if canManageTeachers() && ownsBoth();
      allow delete: if false; // app only deactivates teachers via status update
    }

    // Classes/streams + subjects - read broadly (used in dropdowns
    // everywhere), write restricted to whoever manages term structure.
    match /classes/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageAcademicStructure() && ownsIncoming();
      allow update: if canManageAcademicStructure() && ownsBoth();
      allow delete: if canManageAcademicStructure() && ownsExisting();
    }
    match /subjects/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageAcademicStructure() && ownsIncoming();
      allow update: if canManageAcademicStructure() && ownsBoth();
      allow delete: if canManageAcademicStructure() && ownsExisting();
    }

    // Timetable periods + slots - same group as above.
    match /periods/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageAcademicStructure() && ownsIncoming();
      allow update: if canManageAcademicStructure() && ownsBoth();
      allow delete: if canManageAcademicStructure() && ownsExisting();
    }
    match /timetable_slots/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageAcademicStructure() && ownsIncoming();
      allow update: if canManageAcademicStructure() && ownsBoth();
      allow delete: if canManageAcademicStructure() && ownsExisting();
    }

    // Assessments - read broadly (marks entry, grading, report cards, the
    // dashboard all need to see them), write restricted to admin/
    // academic_master, including locking/reopening and deleting.
    match /assessments/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageAssessments() && ownsIncoming();
      allow update: if canManageAssessments() && ownsBoth();
      allow delete: if canManageAssessments() && ownsExisting();
    }

    // Marks - read broadly (grading/report cards). Write limited to the
    // teacher roles that actually enter marks, and - unlike before -
    // blocked outright once the parent assessment is locked, so that
    // protection can no longer be skipped by calling the SDK directly
    // instead of going through marks.service.js.
    match /marks/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canEnterMarks() && ownsIncoming()
        && (!('assessmentId' in request.resource.data) || !assessmentIsLocked(request.resource.data.assessmentId));
      allow update: if canEnterMarks() && ownsBoth()
        && (!('assessmentId' in request.resource.data) || !assessmentIsLocked(request.resource.data.assessmentId));
      allow delete: if false; // app never deletes marks
    }

    // Result releases - one doc per grade/year/term/mode, controlling
    // whether the public results portal (netlify/edge-functions/
    // results-lookup.ts) is allowed to hand that batch of results to a
    // parent, and when it stops (expiresAt). The edge function reads this
    // collection with a service-account credential that bypasses these
    // rules entirely (same as it does for /results and /students) - this
    // rule only governs the in-app Release Results screen. Same write
    // group as computing results in the first place, since releasing is
    // the natural next step after Save Results.
    match /result_releases/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canComputeResults() && ownsIncoming();
      allow update: if canComputeResults() && ownsBoth();
      allow delete: if false;
    }

    // Results - read broadly (report cards, grading page). Full
    // compute/publish is admin/academic_master only; class_teacher may
    // only ever touch their own remark field, and principal/deputy
    // principal only theirs - never the marks/positions/grades a result
    // is actually built from.
    match /results/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canComputeResults() && ownsIncoming();
      allow update: if ownsBoth() && (
        canComputeResults() ||
        (myRole() == 'class_teacher' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teacherRemark', 'updatedAt'])) ||
        (inRoles(['principal', 'deputy_principal']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['principalRemark', 'updatedAt']))
      );
      allow delete: if false;
    }

    // Attendance - read broadly (dashboard, student profile). Write
    // limited to class_teacher (their own class, enforced client-side by
    // which roster they're shown) and admin/principal (any class).
    match /attendance/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canMarkAttendance() && ownsIncoming();
      allow update: if canMarkAttendance() && ownsBoth();
      allow delete: if false;
    }

    // Fee structures - read broadly (dashboard stat, report card balance
    // for every role that can print one), write admin/bursar only.
    match /fees/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageFees() && ownsIncoming();
      allow update: if canManageFees() && ownsBoth();
      allow delete: if canManageFees() && ownsExisting();
    }

    // Per-student, per-term balance summary - written by fee.service.js
    // (syncStudentFeeStatus()/resyncFeeStatusForGrade()) as a side effect of
    // recording a payment or saving a fee structure, never edited directly
    // by a user. Read/write groups mirror /fees 1:1 since it's derived from
    // the same data and gated by the same actions.
    match /student_fee_status/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageFees() && ownsIncoming();
      allow update: if canManageFees() && ownsBoth();
      allow delete: if canManageFees() && ownsExisting();
    }

    // Fee payments - same read reasoning as fees. Writes are create-only
    // (the app never edits or deletes a recorded payment - corrections go
    // in as a new entry), admin/bursar only.
    match /fee_payments/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageFees() && ownsIncoming();
      allow update, delete: if false;
    }

    // Notifications + newsletters - every role reads them (Notifications
    // page is allRoles), composing/editing/deleting is the narrower
    // CAN_MANAGE set from notifications.js (notably excludes
    // subject_teacher).
    match /notifications/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageComms() && ownsIncoming();
      allow update: if canManageComms() && ownsBoth();
      allow delete: if canManageComms() && ownsExisting();
    }
    match /newsletters/{docId} {
      allow read: if isStaff() && ownsExisting();
      allow create: if canManageComms() && ownsIncoming();
      allow update: if canManageComms() && ownsBoth();
      allow delete: if canManageComms() && ownsExisting();
    }

    // Audit log: append-only. Staff read/create only their own school's
    // entries; the super_admin's platform-level actions (create/suspend a
    // school) are logged with schoolId == null, matching what
    // audit.service.js actually writes for those actions.
    match /audit_logs/{logId} {
      allow read: if (isStaff() && ownsExisting()) || (isSuperAdmin() && (resource == null || resource.data.schoolId == null));
      allow create: if isSignedIn() && (
        (isStaff() && mySchoolId() != null && request.resource.data.schoolId == mySchoolId()) ||
        (isSuperAdmin() && (!('schoolId' in request.resource.data) || request.resource.data.schoolId == null))
      );
      allow update, delete: if false;
    }

    // Platform-wide status announcements (maintenance windows, degraded-
    // service notices, surveys, etc.) - authored by the super_admin from
    // /platform-announcements and surfaced as a dismissible banner in every
    // signed-in staff member's app shell (js/components/announcement-banner.js),
    // regardless of which school they belong to. Deliberately NOT scoped by
    // schoolId/ownsExisting()/ownsIncoming() - unlike every collection
    // above, this isn't tenant data, it's the platform operator talking to
    // every tenant at once, so every signed-in staff role needs read access
    // and a lapsed/suspended school must still be able to see e.g. "we're
    // aware of the outage" on whatever screen isSubscriptionActive() left
    // them on. Write stays super_admin-only - no school's own admin can
    // post into every other school's dashboard.
    match /platform_announcements/{docId} {
      allow read: if isSignedIn() && (isStaff() || isSuperAdmin());
      allow create, update, delete: if isSuperAdmin();
    }

    // school_settings was never actually used by the app (settings.service.js
    // reads/writes the schools/{id} doc above instead) - dropped rather than
    // left open as unused attack surface. Add it back with the same
    // ownsExisting()/ownsIncoming() pattern above if it's ever wired up.

    // lookup_attempts/{schoolId_admissionNumber} - failed-attempt counters
    // for the public results portal (netlify/edge-functions/results-lookup.ts).
    // That function authenticates with a Google service-account credential,
    // which reads/writes Firestore with Admin-level authority and bypasses
    // these rules entirely - so this collection is never actually reached
    // through a client SDK call. Explicit deny here anyway, so the intent
    // is documented rather than relying silently on default-deny, and so a
    // future refactor that accidentally routes a client call through this
    // collection fails closed instead of open.
    match /lookup_attempts/{docId} {
      allow read, write: if false;
    }

    // No catch-all wildcard anymore: every operational collection above is
    // named explicitly, and anything not matched here is denied by
    // Firestore's default-deny, rather than silently falling through to a
    // blanket "any staff role in the school" rule.
  }
}